# Скопируйте в .env и заполните. Файл читается docker-compose.
# .env уже в .gitignore — токены в репозиторий не утекут.

# --- Claude Code CLI (сопроводительные письма) ---
# Долгоживущий токен для подписки Claude. Получается на хосте командой:
#   claude setup-token
CLAUDE_CODE_OAUTH_TOKEN=
# Либо обычный ключ API вместо подписки
ANTHROPIC_API_KEY=

# --- Прокси ---
# Прокси для скачивания установщика claude во время `docker compose build`.
# claude.ai отдает HTML-заглушку "App unavailable in region" там, где заблокирован
CLAUDE_BUILD_PROXY=http://host.docker.internal:1081

# --- Прокси для запросов ---
# api.anthropic.com доступен не отовсюду. Если прокси слушает на хосте, то
# изнутри контейнера он виден как host.docker.internal.
# ВАЖНО: заданные тут переменные достанутся и запросам к hh.ru. Чтобы hh.ru
# ходил напрямую, либо не задавайте их здесь и пропишите прокси в секции
# claude конфига, либо добавьте --no-proxy к командам в crontab
# HTTP_PROXY=http://host.docker.internal:1081
# HTTPS_PROXY=http://host.docker.internal:1081
# NO_PROXY=localhost,127.0.0.1

# --- Прочее ---
# TZ=Europe/Moscow
